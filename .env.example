# ==============================================================================
# INDEX — AI-POWERED ARCHIVAL FILE MANAGEMENT SYSTEM
# Environment Configuration
# ==============================================================================

# Server Network Settings
HOST=127.0.0.1
PORT=8000

# AI Provider Configuration
# If GEMINI_API_KEY is left empty, the application gracefully operates in
# Intelligent Offline Heuristic mode, ensuring full functionality during offline demos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Alternative Provider: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Storage limit
MAX_UPLOAD_SIZE_MB=50
